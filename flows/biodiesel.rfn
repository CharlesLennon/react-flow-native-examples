{
  "format": "rfn/1.0",
  "id": "biodiesel-3-tier",
  "name": "Biodiesel 3-Tier Processor",
  "version": "1.3.0",
  "description": "Gravity-fed 3-tier biodiesel system with dual-input methoxide dosing pump, glycerine separation note, animated barrel fluid levels, and custom batch console.",
  "console": {
    "title": "Biodiesel Batch Console",
    "controls": [
      {
        "type": "transport",
        "param": "batchProgress",
        "step": 2,
        "intervalMs": 300,
        "loop": true,
        "autoPlay": true,
        "timeScales": [0.5, 1, 2, 5],
        "defaultTimeScale": 1,
        "playLabel": "Play Batch",
        "pauseLabel": "Pause Batch"
      },
      { "type": "stageBanner", "label": "Stage", "computeKey": "stageName" },
      { "type": "slider", "param": "batchProgress" },
      { "type": "slider", "param": "batchLiters" },
      { "type": "slider", "param": "titrationGpl" },
      { "type": "slider", "param": "targetTempC" },
      { "type": "toggle", "param": "dosingEnabled" },
      {
        "type": "metrics",
        "items": [
          { "key": "methanolLiters", "label": "MeOH (20%)", "unit": "L" },
          { "key": "naohGrams", "label": "NaOH Catalyst", "unit": "g" },
          { "key": "methoxideLiters", "label": "Methoxide Vol", "unit": "L" },
          { "key": "pumpFlowLpm", "label": "Dosing Flow", "unit": "L/min" },
          { "key": "glycerolLiters", "label": "Waste Glycerine", "unit": "L" },
          { "key": "biodieselLiters", "label": "B100 Yield", "unit": "L" }
        ]
      }
    ]
  },
  "parameters": [
    { "key": "batchProgress", "label": "Batch Progress", "type": "number", "default": 0, "min": 0, "max": 100, "step": 2, "unit": "%" },
    { "key": "batchLiters", "label": "Batch Oil", "type": "number", "default": 150, "min": 20, "max": 200, "step": 10, "unit": "L" },
    { "key": "titrationGpl", "label": "Titration (NaOH)", "type": "number", "default": 4.5, "min": 2.0, "max": 9.0, "step": 0.5, "unit": "g/L" },
    { "key": "targetTempC", "label": "Dry/Heat Temp", "type": "number", "default": 55, "min": 20, "max": 70, "step": 1, "unit": "°C" },
    { "key": "dosingEnabled", "label": "Dosing Pump Power", "type": "boolean", "default": true }
  ],
  "logic": {
    "compute": {
      "methanolLiters": "round(batchLiters * 0.20, 1)",
      "naohGrams": "round(batchLiters * (3.5 + titrationGpl), 0)",
      "methoxideLiters": "round(methanolLiters + naohGrams / 2130, 1)",
      "heatReady": "targetTempC >= 52 && targetTempC <= 60",
      "overTemp": "targetTempC > 60",
      "dosingActive": "dosingEnabled && heatReady && batchLiters > 0",
      "totalMixLiters": "round(batchLiters + methoxideLiters, 1)",
      "pumpFlowLpm": "dosingActive ? round(totalMixLiters / 15, 1) : 0",
      "glycerolLiters": "dosingActive ? round(batchLiters * 0.18, 1) : 0",
      "biodieselLiters": "dosingActive ? round(batchLiters * 0.98, 1) : 0",
      "stage1": "batchProgress > 0 && batchProgress <= 20",
      "stage2": "batchProgress > 20 && batchProgress <= 45",
      "stage3": "batchProgress > 45 && batchProgress <= 70",
      "stage4": "batchProgress > 70",
      "stageName": "batchProgress == 0 ? 'Idle (Ready)' : stage1 ? '1. Settling → Dry/Heat' : stage2 ? '2. Methoxide Dosing' : stage3 ? '3. Reaction & Glycerine Drain' : '4. Wash, Filter & B100'",
      "lvlRaw": "round(clamp(100 - batchProgress * 5, 0, 100), 0)",
      "lvlDry": "batchProgress < 20 ? round(clamp(batchProgress * 4.5, 0, 90), 0) : dosingActive ? round(clamp(90 - (batchProgress - 20) * 3.6, 0, 90), 0) : 90",
      "lvlMeth": "dosingActive ? round(clamp(85 - (batchProgress - 20) * 3.4, 0, 85), 0) : 85",
      "lvlProc": "!dosingActive ? 0 : batchProgress < 45 ? round(clamp((batchProgress - 20) * 3.8, 0, 95), 0) : round(clamp(95 - (batchProgress - 45) * 3.8, 0, 95), 0)",
      "lvlWaste": "dosingActive ? round(clamp((batchProgress - 45) * 3.0, 0, 75), 0) : 0",
      "lvlWash": "!dosingActive ? 0 : batchProgress < 70 ? round(clamp((batchProgress - 45) * 3.4, 0, 85), 0) : round(clamp(85 - (batchProgress - 70) * 2.83, 0, 85), 0)",
      "lvlStor": "dosingActive ? round(clamp((batchProgress - 70) * 3.16, 0, 95), 0) : 0"
    },
    "nodeBindings": {
      "raw-oil": {
        "badge": "{{lvlRaw}}% • {{batchLiters}} L WVO",
        "status": "stage1 ? 'active' : 'idle'",
        "level": "lvlRaw",
        "liquidColor": "'#d97706'"
      },
      "dry-heat": {
        "badge": "overTemp ? 'OVERHEAT ' + targetTempC + '°C' : heatReady ? lvlDry + '% • ' + targetTempC + '°C READY' : lvlDry + '% • COLD ' + targetTempC + '°C'",
        "status": "overTemp ? 'error' : !heatReady ? 'warn' : (stage1 || stage2) ? 'active' : 'idle'",
        "level": "lvlDry",
        "liquidColor": "'#f59e0b'"
      },
      "methoxide-tank": {
        "badge": "{{lvlMeth}}% • {{methanolLiters}}L + {{naohGrams}}g",
        "status": "stage2 && dosingActive ? 'active' : 'idle'",
        "level": "lvlMeth",
        "liquidColor": "'#a855f7'"
      },
      "dosing-pump": {
        "badge": "!dosingEnabled ? 'PUMP OFF' : overTemp ? 'LOCKED: OVERHEAT' : !heatReady ? 'LOCKED: <52°C' : stage2 ? pumpFlowLpm + ' L/min • DOSING' : 'STANDBY (2-IN)'",
        "status": "!dosingActive ? 'warn' : stage2 ? 'active' : 'idle'"
      },
      "processor": {
        "badge": "stage2 ? lvlProc + '% • Filling' : stage3 ? lvlProc + '% • Separating' : lvlProc + '%'",
        "status": "(stage2 || stage3) && dosingActive ? 'active' : 'idle'",
        "level": "lvlProc",
        "liquidColor": "'#eab308'"
      },
      "waste": {
        "badge": "stage3 && dosingActive ? lvlWaste + '% • Draining ' + glycerolLiters + 'L' : lvlWaste + '% • ' + glycerolLiters + ' L Glyc'",
        "status": "stage3 && dosingActive ? 'active' : 'idle'",
        "level": "lvlWaste",
        "liquidColor": "'#78350f'"
      },
      "note-glycerine-sep": {
        "badge": "stage3 && dosingActive ? 'ACTIVE: Draining Bottom Layer' : 'Stage 3 Gravity Separation'",
        "status": "stage3 && dosingActive ? 'active' : 'idle'"
      },
      "wash-dry": {
        "badge": "stage3 ? lvlWash + '% • Filling' : stage4 ? lvlWash + '% • Washing' : lvlWash + '%'",
        "status": "(stage3 || stage4) && dosingActive ? 'active' : 'idle'",
        "level": "lvlWash",
        "liquidColor": "'#fbbf24'"
      },
      "filters": {
        "badge": "stage4 && dosingActive ? 'Polishing 10µ→5µ' : 'Standby'",
        "status": "stage4 && dosingActive ? 'active' : 'idle'"
      },
      "storage": {
        "badge": "{{lvlStor}}% • {{biodieselLiters}} L B100",
        "status": "stage4 && dosingActive ? 'active' : 'idle'",
        "level": "lvlStor",
        "liquidColor": "'#10b981'"
      }
    },
    "edgeBindings": {
      "e-raw-dry": { "active": "stage1 && batchLiters > 0", "label": "{{batchLiters}}L WVO" },
      "e-dry-pump": { "active": "stage2 && dosingActive", "label": "IN 1: Oil" },
      "e-meth-pump": { "active": "stage2 && dosingActive", "label": "IN 2: MeONa" },
      "e-pump-proc": { "active": "stage2 && dosingActive", "label": "{{pumpFlowLpm}} L/min" },
      "e-proc-waste": { "active": "stage3 && dosingActive", "label": "{{glycerolLiters}}L Glyc" },
      "e-proc-wash": { "active": "stage3 && dosingActive", "label": "{{biodieselLiters}}L Crude" },
      "e-wash-filt": { "active": "stage4 && dosingActive", "label": "Wash Out" },
      "e-filt-stor": { "active": "stage4 && dosingActive", "label": "Clean B100" }
    }
  },
  "nodes": [
    {
      "id": "raw-oil",
      "type": "custom",
      "position": { "x": 110, "y": 30 },
      "data": { "label": "DRUM 1: Raw Oil (Settling)", "color": "#94a3b8", "kind": "drum" }
    },
    {
      "id": "methoxide-tank",
      "type": "custom",
      "position": { "x": 440, "y": 30 },
      "data": { "label": "DRUM 7: Methoxide Mix", "color": "#8b5cf6", "kind": "drum", "variant": "mix" }
    },
    {
      "id": "note-glycerine-sep",
      "type": "custom",
      "position": { "x": 830, "y": 20 },
      "data": {
        "kind": "note",
        "label": "How Waste Glycerine Separates",
        "noteText": "After transesterification in DRUM 3, the batch settles by gravity. Heavy glycerine + spent NaOH (1.26 g/cm³) sinks to the bottom cone and drains into DRUM 6, while lighter crude biodiesel (0.88 g/cm³) floats above and routes to DRUM 4."
      }
    },
    {
      "id": "dry-heat",
      "type": "custom",
      "position": { "x": 110, "y": 270 },
      "data": { "label": "DRUM 2: Dry & Heat", "color": "#3b82f6", "kind": "drum", "variant": "heat" }
    },
    {
      "id": "dosing-pump",
      "type": "custom",
      "position": { "x": 440, "y": 280 },
      "data": {
        "label": "Meth-Oxide Dosing Pump",
        "color": "#f8fafc",
        "kind": "pump",
        "inputs": ["IN 1: Heated Oil", "IN 2: Methoxide"]
      }
    },
    {
      "id": "processor",
      "type": "custom",
      "position": { "x": 780, "y": 270 },
      "data": { "label": "DRUM 3: Processor", "color": "#3b82f6", "kind": "drum", "variant": "mix" }
    },
    {
      "id": "waste",
      "type": "custom",
      "position": { "x": 1060, "y": 270 },
      "data": { "label": "DRUM 6: Waste Glycerine", "color": "#f97316", "kind": "drum" }
    },
    {
      "id": "wash-dry",
      "type": "custom",
      "position": { "x": 440, "y": 530 },
      "data": { "label": "DRUM 4: Wash & Dry", "color": "#3b82f6", "kind": "drum" }
    },
    {
      "id": "filters",
      "type": "custom",
      "position": { "x": 720, "y": 540 },
      "data": { "label": "Filters (10 & 5 Micron)", "color": "#f8fafc", "kind": "filter" }
    },
    {
      "id": "storage",
      "type": "custom",
      "position": { "x": 980, "y": 530 },
      "data": { "label": "DRUM 5: Finished Fuel", "color": "#3b82f6", "kind": "drum", "variant": "fuel" }
    }
  ],
  "edges": [
    { "id": "e-raw-dry", "source": "raw-oil", "target": "dry-heat", "sourceHandle": "bottom", "targetHandle": "top", "animated": false, "type": "smoothstep", "style": { "stroke": "#f59e0b", "strokeWidth": 3 } },
    { "id": "e-dry-pump", "source": "dry-heat", "target": "dosing-pump", "sourceHandle": "right", "targetHandle": "left", "animated": false, "type": "smoothstep", "style": { "stroke": "#3b82f6", "strokeWidth": 3 } },
    { "id": "e-meth-pump", "source": "methoxide-tank", "target": "dosing-pump", "sourceHandle": "bottom", "targetHandle": "top", "animated": false, "type": "smoothstep", "style": { "stroke": "#8b5cf6", "strokeWidth": 3 } },
    { "id": "e-pump-proc", "source": "dosing-pump", "target": "processor", "sourceHandle": "right", "targetHandle": "left", "animated": false, "type": "smoothstep", "style": { "stroke": "#7c3aed", "strokeWidth": 3 } },
    { "id": "e-proc-waste", "source": "processor", "target": "waste", "sourceHandle": "right", "targetHandle": "left", "animated": false, "type": "smoothstep", "style": { "stroke": "#f97316", "strokeWidth": 3 } },
    { "id": "e-note-waste", "source": "note-glycerine-sep", "target": "waste", "sourceHandle": "bottom", "targetHandle": "top", "animated": false, "type": "smoothstep", "style": { "stroke": "#94a3b8", "strokeWidth": 1.5, "strokeDasharray": "5,5" } },
    { "id": "e-proc-wash", "source": "processor", "target": "wash-dry", "sourceHandle": "bottom", "targetHandle": "top", "animated": false, "type": "smoothstep", "style": { "stroke": "#3b82f6", "strokeWidth": 3 } },
    { "id": "e-wash-filt", "source": "wash-dry", "target": "filters", "sourceHandle": "right", "targetHandle": "left", "animated": false, "type": "smoothstep", "style": { "stroke": "#3b82f6", "strokeWidth": 3 } },
    { "id": "e-filt-stor", "source": "filters", "target": "storage", "sourceHandle": "right", "targetHandle": "left", "animated": false, "type": "smoothstep", "style": { "stroke": "#10b981", "strokeWidth": 3 } }
  ]
}
